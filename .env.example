# ADO.NET format (Recommended)
ConnectionStrings__DefaultConnection=Host=ep-example-pooler.us-east-2.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=YOUR_NEON_PASSWORD;SSL Mode=Require;

# URI format (Alternative)
# DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ============================================
# JWT AUTHENTICATION
# ============================================
Jwt__SecretKey=YOUR_MINIMUM_32_CHARACTERS_LONG_JWT_SECRET_KEY_HERE!
Jwt__Issuer=JobPortalAPI
Jwt__Audience=JobPortalClients
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7

# ============================================
# FILE STORAGE
# ============================================
FileStorage__ResumeStoragePath=uploads/resumes
FileStorage__ResumeMaxSizeBytes=5242880

# ============================================
# ASP.NET CORE & HOSTING
# ============================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# ============================================
# CORS ALLOWED ORIGINS
# ============================================
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:5173
